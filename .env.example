# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=expense_tracker

# ── App ───────────────────────────────────────────
SECRET_KEY=                              # 필수 — 32자 이상, 미설정/짧으면 서버 시작 불가
SESSION_COOKIE_SECURE=false              # HTTPS 배포 시 true
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ── CORS ──────────────────────────────────────────
# 쉼표로 구분된 허용 오리진. 미설정 시 로컬 개발용 기본값 사용.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI (BYOK) ─────────────────────────────────────
# 서버 공용 AI 키는 두지 않는다. 각 사용자가 마이페이지에서 자기 API 키를 등록해
# 자기 비용으로 AI 어드바이저를 쓴다(member_ai_credentials 에 암호화 저장).
# 아래는 그 사용자 키를 암호화하는 서버 시크릿(선택). 미설정 시 SECRET_KEY 파생 키로 폴백.
AI_ENC_KEY=

# ── 로컬 LLM (선택 · provider='local') ─────────────
# OpenAI 호환 엔드포인트를 내는 로컬 추론 서버. 설정하면 마이페이지 프로바이더 목록에
# "로컬 모델 (API 키 불필요)" 가 추가된다 — 키 없이·비용 없이·데이터가 밖으로 안 나간다.
# **비워두면 그 선택지 자체가 안 보인다**(서버 없는 배포 인스턴스에서 고르면 매 호출이
# 실패하므로). 사용자 입력이 아니라 이 환경변수로만 정한다(SSRF 방지).
#   Ollama:  http://localhost:11434/v1
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:latest

# ── 배포 (로컬 개발엔 불필요 · 컨테이너/AWS 에서만 설정) ──
# BIND_HOST=0.0.0.0                 # 컨테이너에서 외부 접속 허용 (기본 127.0.0.1)
# PORT=5000
# BACKEND_URL=http://backend:5000   # 프론트(Next)가 프록시할 백엔드 주소 (compose 내부)
# DOMAIN=your-domain.com            # Caddy 자동 HTTPS 대상 도메인
# DB_SSL_CA=/etc/ssl/rds-ca.pem     # RDS TLS 검증용 CA 인증서 경로 (설정 시 DB 연결 암호화)
