# 환경변수 (API 키, DB 비밀번호 등 - 절대 올리면 안 됨!)
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 가상환경
venv/
env/
.venv/
.venv64/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
logs/*.log

# Node (우리카드 VestMail 복호화용 vestmail/ 의존성)
vestmail/node_modules/

# Python test cache
.pytest_cache/

# DB dumps / backups (실 데이터·해시 포함 - 절대 올리면 안 됨!)
backup/db/*.sql
_db_backup/
backup/

# AI assistant config / docs
.claude/
.gemini/
CLAUDE.md
